<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block access to dotfiles (.env, .git, .htaccess itself, etc.)
    RewriteRule (^|/)\.[^/]+ - [F,L]

    # Block direct access to application internals even if rewrite rules above miss something.
    # NOTE: "storage" is intentionally NOT blocked — /storage/* serves public files
    # through the public/storage symlink (avatars, uploads). Requests below the
    # symlink that don't exist under storage/app/public simply 404.
    RewriteRule ^(app|bootstrap|config|database|docs|node_modules|routes|tests|vendor)(/.*)?$ - [F,L]

    # Everything else is served from public/ (Laravel web root)
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
