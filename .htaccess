<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block access to dotfiles (.env, .git, .htaccess itself, etc.)
    RewriteRule (^|/)\.[^/]+ - [F,L]

    # Block direct access to application internals even if rewrite rules above miss something
    RewriteRule ^(app|bootstrap|config|database|docs|node_modules|routes|tests|vendor|storage)(/.*)?$ - [F,L]

    # Everything else is served from public/ (Laravel web root)
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
