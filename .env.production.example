# ============================================================
# PRODUCTION ENVIRONMENT — Amoleck Group Company LTD
# Copy to .env on the server. NEVER commit the real .env file.
# ============================================================
APP_NAME="Amoleck Group Company LTD"
APP_ENV=production
APP_KEY=                    # run: php artisan key:generate
APP_DEBUG=false             # MUST be false — leaks stack traces/secrets if true
APP_URL=https://staff.amoleck.co.tz   # HTTPS required — enables HSTS + secure cookies
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Africa/Dar_es_Salaam

LOG_CHANNEL=stack
LOG_LEVEL=warning            # keep noisy debug logs out of production
LOG_DEPRECATIONS_CHANNEL=null

# ---- Database (MySQL recommended for production) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=amoleck_staff   # cPanel format: <user>_<db> — badilisha prefix kama ni tofauti
DB_USERNAME=amoleck_staff   # user uliotengeneza kwenye cPanel → MySQL Databases
DB_PASSWORD=                # jaza password ya DB user hapo juu

# ---- Sessions (encrypted, secure cookies) ----
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true   # HTTPS only
SESSION_PATH=/
SESSION_DOMAIN=null

# ---- Cache & Queue ----
CACHE_STORE=database
QUEUE_CONNECTION=database    # or redis for higher volume
BROADCAST_CONNECTION=log

FILESYSTEM_DISK=local        # documents stay in private storage — never public

# ---- Mail (optional — for notifications/password resets) ----
MAIL_MAILER=smtp
MAIL_HOST=mail.amoleck.co.tz   # au localhost kama mail iko kwenye server hiyo hiyo
MAIL_PORT=587
MAIL_USERNAME=noreply@amoleck.co.tz   # email account uliotengeneza kwenye cPanel
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@amoleck.co.tz"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Redis (optional, if used for cache/queue) ----
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
